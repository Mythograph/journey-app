---
import Base from "~/layouts/Base.astro";
import { LEGAL_UPDATED, type LegalPage } from "~/lib/legal";

interface Props { page: LegalPage }
const { page } = Astro.props;
---

<Base title={`${page.title} · Journey · Mythograph`}>
  <p class="text-sm"><a href="/">Journey</a></p>
  <h1 class="mt-4">{page.title}</h1>
  <p class="mt-2 italic text-[#7A6D5E]">{page.lede}</p>
  <p class="mt-1 text-sm text-[#7A6D5E]">Last updated {LEGAL_UPDATED}</p>
  {page.sections.map((s) => (
    <section class="mt-8">
      <h2 class="text-xl">{s.heading}</h2>
      {s.paragraphs.map((p) => <p class="mt-3">{p}</p>)}
    </section>
  ))}
</Base>
