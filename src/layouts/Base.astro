---
import "~/styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Human Design bodygraph chart and Journey Narrative reading by Cléa Hernández." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <main class="mx-auto max-w-3xl px-6 py-16">
      <slot />
    </main>
  </body>
</html>
