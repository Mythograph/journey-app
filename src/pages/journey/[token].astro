---
import "~/styles/global.css";
import { getPurchase, updatePurchase } from "~/lib/purchases.js";
import { generateChart } from "~/lib/chart-engine/index.js";
import { REFLECTION_MARKER } from "~/lib/cosmic-core/index.js";
import type { BirthData, Chart } from "~/lib/chart-engine/types.js";

const { token } = Astro.params;
const purchase = token ? await getPurchase(token) : null;

if (!purchase) {
  return Astro.redirect("/?error=invalid-token", 302);
}

if (Astro.request.method === "POST") {
  const body = await Astro.request.formData();
  const birthData: BirthData = {
    date: String(body.get("date") ?? ""),
    time: String(body.get("time") ?? ""),
    city: String(body.get("city") ?? ""),
  };
  if (birthData.date && birthData.time && birthData.city) {
    await updatePurchase(purchase.token, { birthData });
  }
  return Astro.redirect(`/journey/${token}`, 303);
}

const hasBirthData = Boolean(purchase.birthData);
const hasNarrative = Boolean(purchase.narrative);

const SECTION_META: Record<string, { num: string; title: string }> = {
  "THE ORDINARY WORLD":                  { num: "I",     title: "The Ordinary World" },
  "THE SHAPE OF MY ENERGY":              { num: "II",    title: "The Shape of My Energy" },
  "THE CALL":                            { num: "III",   title: "The Call" },
  "THE THRESHOLD":                       { num: "IV",    title: "Crossing Into the Unknown" },
  "THE DESCENT":                         { num: "V",     title: "Initiations and Early Trials" },
  "THE ABYSS":                           { num: "VI",    title: "The Central Ordeal" },
  "THE HELPERS AND ALLIES":              { num: "VII",   title: "The Helpers and Allies" },
  "THE ROAD OF TRIALS":                  { num: "VIII",  title: "The Recurring Tests" },
  "THE GAUNTLET":                        { num: "IX",    title: "Training With My Design" },
  "THE SPIRITUAL PATH":                  { num: "X",     title: "The Invisible Current" },
  "THE CORE WOUND AND THE VOCATION":     { num: "XI",    title: "The Fight Worth Having" },
  "THE ELIXIR":                          { num: "XII",   title: "What I Carry Back" },
  "THE VOICE":                           { num: "XIII",  title: "How I Transmit" },
  "THE RETURN":                          { num: "XIV",   title: "Leaning Into the Fullness" },
  "AM I MADE FOR THIS MOMENT?":          { num: "XV",    title: "Am I Made for This Moment?" },
  "THE VILLAGE JOURNEY":                 { num: "XVI",   title: "The Village Journey" },
  "WHO I AM":                            { num: "XVII",  title: "A Recap" },
  "THE LARGER STORY":                    { num: "XVIII", title: "The Larger Story" },
};

const HEADING_KEYS = Object.keys(SECTION_META);

// ── Gate annotations ──────────────────────────────────────────────────────────

const PLANET_HDNAME: Record<string, string> = {
  sun: "Sun", earth: "Earth", moon: "Moon", mercury: "Mercury",
  venus: "Venus", mars: "Mars", jupiter: "Jupiter", saturn: "Saturn",
  uranus: "Uranus", neptune: "Neptune", pluto: "Pluto",
  north_node: "NorthNode", south_node: "SouthNode", chiron: "Chiron",
};
const PLANET_LABEL: Record<string, string> = {
  sun: "Sun", earth: "Earth", moon: "Moon", mercury: "Mercury",
  venus: "Venus", mars: "Mars", jupiter: "Jupiter", saturn: "Saturn",
  uranus: "Uranus", neptune: "Neptune", pluto: "Pluto",
  north_node: "North Node", south_node: "South Node", chiron: "Chiron",
};

// Which planets feed each section (matches the narrative prompt structure)
const SECTION_PLANETS: Record<string, { planet: string; pos: "conscious" | "unconscious" }[]> = {
  "THE ORDINARY WORLD":              [{ planet: "uranus",     pos: "conscious" }, { planet: "uranus",     pos: "unconscious" }],
  "THE CALL":                        [{ planet: "sun",        pos: "conscious" }, { planet: "sun",        pos: "unconscious" }],
  "THE THRESHOLD":                   [],
  "THE DESCENT":                     [{ planet: "south_node", pos: "conscious" }, { planet: "south_node", pos: "unconscious" },
                                      { planet: "pluto",      pos: "conscious" }, { planet: "pluto",      pos: "unconscious" }],
  "THE ABYSS":                       [{ planet: "chiron",     pos: "conscious" }, { planet: "chiron",     pos: "unconscious" }],
  "THE HELPERS AND ALLIES":          [{ planet: "moon",       pos: "conscious" }, { planet: "moon",       pos: "unconscious" }],
  "THE ROAD OF TRIALS":              [{ planet: "saturn",     pos: "conscious" }, { planet: "saturn",     pos: "unconscious" },
                                      { planet: "jupiter",    pos: "conscious" }, { planet: "jupiter",    pos: "unconscious" }],
  "THE SPIRITUAL PATH":              [{ planet: "neptune",    pos: "conscious" }, { planet: "neptune",    pos: "unconscious" }],
  "THE CORE WOUND AND THE VOCATION": [{ planet: "mars",       pos: "unconscious"}, { planet: "mars",      pos: "conscious"   }],
  "THE ELIXIR":                      [{ planet: "sun",        pos: "conscious" }, { planet: "sun",        pos: "unconscious" },
                                      { planet: "earth",      pos: "conscious" }, { planet: "earth",      pos: "unconscious" }],
  "THE VOICE":                       [{ planet: "mercury",    pos: "conscious" }, { planet: "mercury",    pos: "unconscious" },
                                      { planet: "venus",      pos: "conscious" }, { planet: "venus",      pos: "unconscious" }],
  "THE RETURN":                      [{ planet: "north_node", pos: "conscious" }, { planet: "north_node", pos: "unconscious" }],
  "WHO I AM":                        [],
  "THE LARGER STORY":                [{ planet: "uranus",     pos: "conscious" }, { planet: "pluto",      pos: "conscious"   }],
};

// One templated image per section (mythic-peak sections only). Keyed by the
// section heading; sections absent from this map render text-only.
const SECTION_IMAGES: Record<string, string> = {
  "THE ORDINARY WORLD":              "/images/sections/01-ordinary-world.png",
  "THE CALL":                        "/images/sections/02-call.png",
  "THE THRESHOLD":                   "/images/sections/03-threshold.png",
  "THE DESCENT":                     "/images/sections/04-descent.jpg",
  "THE ABYSS":                       "/images/sections/05-abyss.png",
  "THE HELPERS AND ALLIES":          "/images/sections/06-helpers.png",
  "THE SPIRITUAL PATH":              "/images/sections/08-spiritual-path.png",
  "THE CORE WOUND AND THE VOCATION": "/images/sections/09-core-wound.png",
  "THE ELIXIR":                      "/images/sections/10-elixir.png",
  "THE VOICE":                       "/images/sections/11-voice.png",
  "THE RETURN":                      "/images/sections/12-return.png",
  "THE LARGER STORY":                "/images/sections/14-larger-story.png",
};

interface GateTag { planet: string; gate: number; pos: "conscious" | "unconscious" }

function getGateTags(chart: Chart, sectionKey: string): GateTag[] {
  const refs = SECTION_PLANETS[sectionKey] ?? [];
  return refs.flatMap(({ planet, pos }) => {
    const hdName = PLANET_HDNAME[planet];
    if (!hdName) return [];
    const activations = pos === "conscious" ? chart.personalityActivations : chart.designActivations;
    const gate = activations.find(a => a.planet === hdName)?.gate ?? null;
    return gate !== null ? [{ planet, gate, pos }] : [];
  });
}

// Generate chart for gate annotations (fast: pure calculation, no API call)
const chart: Chart | null = purchase.birthData ? await generateChart(purchase.birthData) : null;

// ── Section parsing ───────────────────────────────────────────────────────────

function parseSections(text: string) {
  const sections: { key: string; num: string; title: string; paragraphs: string[] }[] = [];
  let current: typeof sections[0] | null = null;

  const blocks = text.split(/\n\n+/);
  for (const block of blocks) {
    const trimmed = block.trim();
    if (!trimmed) continue;

    const firstLine = trimmed.split("\n")[0].trim()
      .replace(/^#+\s*/, "")
      .replace(/\*\*/g, "");

    const matchKey = HEADING_KEYS.find(k =>
      firstLine === k ||
      firstLine.startsWith(k + " ") ||
      firstLine.startsWith(k + "—") ||
      firstLine.startsWith(k + " —")
    );

    if (matchKey) {
      if (current) sections.push(current);
      const meta = SECTION_META[matchKey];
      current = { key: matchKey, num: meta.num, title: meta.title, paragraphs: [] };
      const rest = trimmed.slice(firstLine.length).trim();
      if (rest) current.paragraphs.push(rest.replace(/\n/g, " "));
    } else if (current) {
      current.paragraphs.push(trimmed.replace(/\n/g, " "));
    }
  }

  if (current) sections.push(current);
  return sections;
}

const narrativeSections = hasNarrative ? parseSections(purchase.narrative!) : [];
const orderedDate = new Date(purchase.paidAt).toLocaleDateString("en-GB", {
  day: "numeric", month: "long", year: "numeric"
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{purchase.name ? `${purchase.name} — Journey Narrative` : "Your Journey Narrative"} · Mythograph</title>
    <style>
      @media print {
        .no-print { display: none !important; }
        nav, footer { display: none !important; }
        body { background: white !important; }
        .narrative-section { page-break-inside: avoid; }
        @page { margin: 2.5cm 3cm; }
        /* Keep a section opener image with the heading that follows it. */
        .journey-image { break-inside: avoid; page-break-after: avoid; max-width: 100%; }
      }
    </style>
  </head>
  <body class="bg-[#FAFAF7] text-[#1A1410] antialiased">

    <!-- Nav -->
    <nav class="no-print border-b border-[#E8E0D6] px-6 py-4 flex items-center justify-between">
      <a
        href="/"
        class="text-[10px] font-medium tracking-[0.2em] uppercase text-[#7A6D5E] hover:text-[#1A1410] transition no-underline"
        style="font-family: 'DM Sans', sans-serif"
      >Mythograph</a>
      {hasNarrative && (
        <button
          onclick="window.print()"
          class="text-[11px] font-medium tracking-[0.07em] uppercase px-5 py-2 rounded bg-[#C05A3C] text-white hover:bg-[#a84e33] transition"
          style="font-family: 'DM Sans', sans-serif"
        >
          Download PDF
        </button>
      )}
    </nav>

    <div class="max-w-2xl mx-auto px-6">

      <!-- Hero -->
      <header class="pt-16 pb-14 border-b border-[#E8E0D6] text-center">
        <p
          class="text-[10px] font-medium tracking-[0.2em] uppercase text-[#C05A3C] mb-6"
          style="font-family: 'DM Sans', sans-serif"
        >Your Journey Narrative</p>
        <h1
          class="text-[#1A1410]"
          style="font-family: 'Fraunces', Georgia, serif; font-weight: 700; font-size: clamp(2.25rem, 6vw, 3.75rem); letter-spacing: -0.03em; line-height: 1.05"
        >
          {purchase.name ? `The Journey of ${purchase.name}` : "Your Journey Narrative"}
        </h1>

        {hasNarrative && (
          <img
            src="/images/sections/cover.png"
            alt=""
            class="journey-image w-full mt-10 rounded-sm"
            style="display: block; object-fit: cover;"
          />
        )}

        {!hasNarrative && (
          <p
            class="no-print mt-4 text-xs text-[#7A6D5E]"
            style="font-family: 'DM Sans', sans-serif"
          >
            {purchase.email} · {orderedDate}
          </p>
        )}
      </header>

      <!-- STATE 1: Birth data form -->
      {!hasBirthData && (
        <section class="no-print py-14">
          <p
            class="text-[10px] font-medium tracking-[0.2em] uppercase text-[#C05A3C] mb-3"
            style="font-family: 'DM Sans', sans-serif"
          >Step One</p>
          <h2
            class="text-[#1A1410] mb-2"
            style="font-family: 'Playfair Display', Georgia, serif; font-weight: 600; font-size: 1.875rem; letter-spacing: -0.02em; line-height: 1.2"
          >Enter your birth details</h2>
          <p
            class="text-sm text-[#7A6D5E] mb-10 leading-relaxed"
            style="font-family: 'DM Sans', sans-serif"
          >
            Your narrative is generated from your exact birth data. This page is your permanent
            reading link — you only need to enter this once.
          </p>
          <form method="POST" class="grid gap-6">
            <div class="grid gap-2">
              <label
                for="date"
                class="text-[10px] font-medium tracking-[0.1em] uppercase text-[#7A6D5E]"
                style="font-family: 'DM Sans', sans-serif"
              >Birth date</label>
              <input
                id="date" name="date" type="date" required
                class="rounded border border-[#D4C9BB] bg-white px-4 py-3 text-sm text-[#1A1410] focus:outline-none focus:ring-2 focus:ring-[#3A4F99] focus:border-transparent transition"
                style="font-family: 'DM Sans', sans-serif"
              />
            </div>
            <div class="grid gap-2">
              <label
                for="time"
                class="text-[10px] font-medium tracking-[0.1em] uppercase text-[#7A6D5E]"
                style="font-family: 'DM Sans', sans-serif"
              >Birth time (local)</label>
              <input
                id="time" name="time" type="time" required
                class="rounded border border-[#D4C9BB] bg-white px-4 py-3 text-sm text-[#1A1410] focus:outline-none focus:ring-2 focus:ring-[#3A4F99] focus:border-transparent transition"
                style="font-family: 'DM Sans', sans-serif"
              />
            </div>
            <div class="grid gap-2">
              <label
                for="city"
                class="text-[10px] font-medium tracking-[0.1em] uppercase text-[#7A6D5E]"
                style="font-family: 'DM Sans', sans-serif"
              >Birth city</label>
              <input
                id="city" name="city" type="text" required placeholder="e.g. London, UK"
                class="rounded border border-[#D4C9BB] bg-white px-4 py-3 text-sm text-[#1A1410] placeholder:text-[#B0A499] focus:outline-none focus:ring-2 focus:ring-[#3A4F99] focus:border-transparent transition"
                style="font-family: 'DM Sans', sans-serif"
              />
            </div>
            <button
              type="submit"
              class="mt-2 rounded bg-[#C05A3C] px-7 py-3 text-[11px] font-medium tracking-[0.07em] uppercase text-white hover:bg-[#a84e33] transition w-full"
              style="font-family: 'DM Sans', sans-serif"
            >Generate my reading</button>
          </form>
        </section>
      )}

      <!-- STATE 2: Generating (polls /api/narrative-ready every 3 s, reloads when done) -->
      {hasBirthData && !hasNarrative && (
        <section class="no-print py-14">
          <div id="generating-status" class="rounded-lg border border-[#E8E0D6] bg-white px-6 py-10 text-center">
            <p
              class="text-[10px] font-medium tracking-[0.2em] uppercase text-[#C05A3C] mb-3"
              style="font-family: 'DM Sans', sans-serif"
            >Writing now</p>
            <p
              id="status-msg"
              class="text-sm text-[#7A6D5E] mb-6"
              style="font-family: 'DM Sans', sans-serif"
            >Your narrative is being composed. This takes about a minute.</p>
            <div class="h-px w-full bg-[#E8E0D6] overflow-hidden rounded-full">
              <div
                id="progress-bar"
                class="h-full bg-[#C05A3C] rounded-full"
                style="width: 4%; transition: width 3s linear"
              ></div>
            </div>
          </div>
          <script define:vars={{ token }}>
            (function () {
              const bar     = document.getElementById("progress-bar");
              const msg     = document.getElementById("status-msg");
              const box     = document.getElementById("generating-status");
              let elapsed   = 0;
              const TARGET  = 90; // seconds until bar reaches ~95%

              // Kick off generation immediately
              fetch(`/api/generate-narrative?token=${encodeURIComponent(token)}`).catch(() => {});

              // Animate progress bar smoothly
              function tick() {
                elapsed += 3;
                const pct = Math.min(95, Math.round((elapsed / TARGET) * 100));
                bar.style.width = pct + "%";
              }

              const poll = setInterval(async () => {
                tick();
                if (elapsed > 150) {
                  clearInterval(poll);
                  msg.textContent = "Still working — please refresh in a moment.";
                  return;
                }
                try {
                  const res  = await fetch(`/api/narrative-ready?token=${encodeURIComponent(token)}`);
                  const data = await res.json();
                  if (data.ready) {
                    clearInterval(poll);
                    bar.style.width = "100%";
                    msg.textContent = "Your narrative is ready. Loading…";
                    setTimeout(() => window.location.reload(), 600);
                  }
                } catch {}
              }, 3000);
            })();
          </script>
        </section>
      )}

      <!-- STATE 3: Narrative ready -->
      {hasNarrative && (
        <article class="py-14 pb-20" id="narrative-content">
          {/* Gate legend — shown once, before the first section */}
          {chart && (
            <p
              class="text-[10px] text-[#B0A499] mb-10 text-center"
              style="font-family: 'DM Sans', sans-serif"
            >
              Gate annotations: <span class="text-[#1A1410]">Personality</span> (what you know and identify with)
              · <span class="text-[#7A6D5E]">Design</span> (what others sense in you)
            </p>
          )}

          {narrativeSections.length > 0 ? (
            narrativeSections.map((section, i) => {
              const tags = chart ? getGateTags(chart, section.key) : [];
              const sectionImage = SECTION_IMAGES[section.key];
              return (
                <div class={`narrative-section${i > 0 ? " mt-16" : ""}`}>
                  {sectionImage && (
                    <img
                      src={sectionImage}
                      alt=""
                      class="journey-image w-full mb-8 rounded-sm"
                      style="display: block; object-fit: cover;"
                    />
                  )}
                  <p
                    class="text-[10px] font-medium tracking-[0.2em] uppercase text-[#C05A3C] mb-2"
                    style="font-family: 'DM Sans', sans-serif"
                  >{section.num}</p>
                  <h2 class="mb-3">{section.title}</h2>

                  {/* Gate tags */}
                  {tags.length > 0 && (
                    <p
                      class="flex flex-wrap gap-x-4 gap-y-0.5 text-[11px] mb-5"
                      style="font-family: 'DM Sans', sans-serif"
                    >
                      {tags.map((tag, ti) => (
                        <span>
                          {ti > 0 && <span class="text-[#D4C9BB] mr-4">·</span>}
                          <span
                            class="font-medium"
                            style={`color: ${tag.pos === "conscious" ? "#1A1410" : "#7A6D5E"}`}
                          >Gate {tag.gate}</span>
                          <span class="text-[#B0A499] ml-1">{PLANET_LABEL[tag.planet]}</span>
                        </span>
                      ))}
                    </p>
                  )}

                  <div class="border-t border-[#E8E0D6] pt-6">
                    {section.paragraphs.map(p => (
                      p.startsWith(REFLECTION_MARKER) ? (
                        <aside
                          class="my-7 border-l-2 border-[#C8A24A] bg-[#F5F0E6] px-5 py-4"
                          style="font-family: 'DM Sans', sans-serif"
                        >
                          <p class="text-[10px] font-medium tracking-[0.2em] uppercase text-[#C8A24A] mb-2">To write with</p>
                          <p class="text-[16px] leading-[1.6] italic text-[#3A332B] m-0">{p.slice(REFLECTION_MARKER.length)}</p>
                        </aside>
                      ) : (
                        <p
                          class="text-[17px] leading-[1.65] text-[#1A1410] mb-5"
                          style="font-family: 'DM Sans', sans-serif"
                        >{p}</p>
                      )
                    ))}
                  </div>
                </div>
              );
            })
          ) : (
            (purchase.narrative ?? "").split(/\n\n+/).filter(Boolean).map(para => (
              <p
                class="text-[17px] leading-[1.65] text-[#1A1410] mb-5"
                style="font-family: 'DM Sans', sans-serif"
              >{para}</p>
            ))
          )}
        </article>
      )}

      <!-- Footer -->
      <footer class="no-print border-t border-[#E8E0D6] py-10 text-center">
        <p
          class="text-[10px] font-medium tracking-[0.2em] uppercase text-[#7A6D5E]"
          style="font-family: 'DM Sans', sans-serif"
        >Mythograph</p>
      </footer>

    </div>
  </body>
</html>
