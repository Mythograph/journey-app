---
import Base from "~/layouts/Base.astro";
import { generateChart } from "~/lib/chart-engine/index.js";
import type { Chart } from "~/lib/chart-engine/index.js";

const PLANET_LABELS: Record<string, string> = {
  Sun: "☉ Sun", Earth: "⊕ Earth", Moon: "☽ Moon",
  Mercury: "☿ Mercury", Venus: "♀ Venus", Mars: "♂ Mars",
  Jupiter: "♃ Jupiter", Saturn: "♄ Saturn", Uranus: "♅ Uranus",
  Neptune: "♆ Neptune", Pluto: "♇ Pluto",
  NorthNode: "☊ N. Node", SouthNode: "☋ S. Node",
};

let chart: Chart | null = null;
let error: string | null = null;
let formData = { date: "", time: "", city: "" };

if (Astro.request.method === "POST") {
  const body = await Astro.request.formData();
  formData = {
    date: String(body.get("date") ?? ""),
    time: String(body.get("time") ?? ""),
    city: String(body.get("city") ?? ""),
  };
  try {
    chart = await generateChart(formData);
  } catch (e) {
    error = e instanceof Error ? e.message : "Unknown error";
  }
}
---

<Base title="Free Chart — Mythograph Journey">
  <div class="mx-auto max-w-3xl">
    <h1 class="text-4xl font-light">Free bodygraph chart</h1>
    <p class="mt-3 text-base opacity-70">
      Enter your birth data to generate your Human Design chart.
    </p>

    <form method="POST" class="mt-8 grid gap-5">
      <div class="grid gap-1.5">
        <label for="date" class="text-sm font-medium">Birth date</label>
        <input
          id="date" name="date" type="date" required
          value={formData.date}
          class="rounded border border-black/20 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#3a4f99]"
        />
      </div>

      <div class="grid gap-1.5">
        <label for="time" class="text-sm font-medium">Birth time (local, 24h)</label>
        <input
          id="time" name="time" type="time" required
          value={formData.time}
          class="rounded border border-black/20 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#3a4f99]"
        />
      </div>

      <div class="grid gap-1.5">
        <label for="city" class="text-sm font-medium">Birth city</label>
        <input
          id="city" name="city" type="text" required placeholder="e.g. London, UK"
          value={formData.city}
          class="rounded border border-black/20 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#3a4f99]"
        />
      </div>

      <button
        type="submit"
        class="mt-2 rounded bg-[#3a4f99] px-6 py-2.5 text-sm font-medium text-white hover:bg-[#2d3f80] transition"
        style="color: white"
      >
        Generate chart
      </button>
    </form>

    {error && (
      <div class="mt-6 rounded border border-red-300 bg-red-50 p-4 text-sm text-red-700">
        {error}
      </div>
    )}

    {chart && (
      <section class="mt-10 space-y-8">
        <!-- Core summary -->
        <div class="rounded-xl border border-black/10 p-6 bg-white/60">
          <h2 class="text-2xl font-light mb-4">Your Human Design</h2>
          <dl class="grid sm:grid-cols-2 gap-x-8 gap-y-3 text-sm">
            <div>
              <dt class="text-xs uppercase tracking-wide opacity-50">Type</dt>
              <dd class="font-semibold text-lg">{chart.type}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide opacity-50">Strategy</dt>
              <dd>{chart.strategy}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide opacity-50">Authority</dt>
              <dd>{chart.authority}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide opacity-50">Profile</dt>
              <dd>{chart.profile}</dd>
            </div>
            <div class="sm:col-span-2">
              <dt class="text-xs uppercase tracking-wide opacity-50">Incarnation Cross</dt>
              <dd>{chart.incarnationCross}</dd>
            </div>
          </dl>
        </div>

        <!-- Bodygraph — full width -->
        <div class="rounded-xl border border-black/10 bg-white/60 overflow-hidden -mx-6">
          <h2 class="text-lg font-light px-6 pt-5 pb-2">Bodygraph</h2>
          <div class="px-4 pb-4">
            <div class="w-full" set:html={chart.bodygraphSvg} />
            <p class="mt-2 text-[9px] opacity-50 select-none text-center">
              <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#111111] mr-1 align-middle"></span>Conscious &nbsp;
              <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#c0392b] mr-1 ml-2 align-middle"></span>Unconscious &nbsp;
              <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#d4740a] mr-1 ml-2 align-middle"></span>Both
            </p>
          </div>
        </div>

        <!-- Planetary activations — two columns below bodygraph -->
        <div class="rounded-xl border border-black/10 bg-white/60 overflow-hidden">
          <div class="grid grid-cols-2 divide-x divide-black/10">
            <!-- Unconscious / Design — left, red -->
            <div class="p-5 text-[12px] leading-snug">
              <p class="text-[9px] font-bold uppercase tracking-widest text-[#c0392b] mb-3">Unconscious (Design)</p>
              {chart.designActivations.map((a) => (
                <div class="flex items-baseline justify-between gap-2 py-[3px]">
                  <span class="text-[#c0392b]/80">{PLANET_LABELS[a.planet] ?? a.planet}</span>
                  <span class="font-mono font-semibold text-[#c0392b] tabular-nums text-[11.5px]">{a.gate}.{a.line}</span>
                </div>
              ))}
            </div>
            <!-- Conscious / Personality — right, black -->
            <div class="p-5 text-[12px] leading-snug">
              <p class="text-[9px] font-bold uppercase tracking-widest text-[#111111]/60 mb-3">Conscious (Personality)</p>
              {chart.personalityActivations.map((a) => (
                <div class="flex items-baseline justify-between gap-2 py-[3px]">
                  <span class="text-[#111111]/60">{PLANET_LABELS[a.planet] ?? a.planet}</span>
                  <span class="font-mono font-semibold text-[#111111] tabular-nums text-[11.5px]">{a.gate}.{a.line}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Defined channels -->
        {chart.definedChannels.length > 0 && (
          <div class="rounded-xl border border-black/10 p-6 bg-white/60">
            <h2 class="text-lg font-light mb-3">Defined channels</h2>
            <div class="flex flex-wrap gap-2">
              {chart.definedChannels.map(([a, b]) => (
                <span class="rounded-full bg-[#3a4f99]/10 px-3 py-1 text-xs font-mono">
                  {a}–{b}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- Debug panel -->
        <details class="rounded-xl border border-black/10 p-4 bg-white/60 text-xs font-mono">
          <summary class="cursor-pointer opacity-50 hover:opacity-100">Debug info</summary>
          <dl class="mt-3 grid gap-1.5">
            <div><dt class="opacity-50">Location found</dt><dd>{chart.debug.geocodedLocation}</dd></div>
            <div><dt class="opacity-50">Timezone</dt><dd>{chart.debug.timezone}</dd></div>
            <div><dt class="opacity-50">Birth UTC</dt><dd>{chart.debug.birthUtc}</dd></div>
            <div><dt class="opacity-50">Design date UTC</dt><dd>{chart.debug.designDate}</dd></div>
            <div><dt class="opacity-50">Personality Sun longitude</dt><dd>{chart.debug.personalitySunLon}°</dd></div>
            <div><dt class="opacity-50">Design Sun longitude</dt><dd>{chart.debug.designSunLon}°</dd></div>
            <div><dt class="opacity-50">All activated gates</dt><dd>{chart.debug.allActivatedGates.join(", ")}</dd></div>
          </dl>
        </details>

        <!-- Upsell -->
        <div class="rounded-xl border border-[#3a4f99]/30 bg-[#3a4f99]/5 p-6">
          <h2 class="text-lg font-light mb-2">Go deeper with the Journey Narrative</h2>
          <p class="text-sm opacity-70 mb-4">
            A long-form personalised reading written in Cléa Hernández's voice — your design, your story.
          </p>
          <a
            href="/#journey-narrative"
            class="inline-block rounded bg-[#3a4f99] px-5 py-2 text-sm font-medium hover:bg-[#2d3f80] transition"
            style="color: white"
          >
            Get your Journey Narrative — $37
          </a>
        </div>
      </section>
    )}

    <p class="mt-8 text-sm">
      <a href="/" class="opacity-50 hover:opacity-100 transition">← back</a>
    </p>
  </div>
</Base>
