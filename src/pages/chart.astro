---
import Base from "~/layouts/Base.astro";
import { generateChart } from "~/lib/chart-engine/index.js";
import type { Chart } from "~/lib/chart-engine/index.js";
import { CHANNELS } from "~/lib/chart-engine/data.js";
import {
  CHANNEL_DESCRIPTIONS,
  TYPE_DESCRIPTIONS,
  AUTHORITY_DESCRIPTIONS,
  STRATEGY_DESCRIPTIONS,
  PROFILE_DESCRIPTIONS,
  channelKey,
} from "~/lib/chart-engine/copy.js";

const PLANET_LABELS: Record<string, string> = {
  Sun: "☉ Sun", Earth: "⊕ Earth", Moon: "☽ Moon",
  Mercury: "☿ Mercury", Venus: "♀ Venus", Mars: "♂ Mars",
  Jupiter: "♃ Jupiter", Saturn: "♄ Saturn", Uranus: "♅ Uranus",
  Neptune: "♆ Neptune", Pluto: "♇ Pluto",
  NorthNode: "☊ N. Node", SouthNode: "☋ S. Node",
};

const CENTER_LABELS: Record<string, string> = {
  Head: "Head", Ajna: "Ajna", Throat: "Throat", G: "G",
  Ego: "Ego", Sacral: "Sacral", SolarPlexus: "Solar Plexus",
  Spleen: "Spleen", Root: "Root",
};

interface ChannelInfo {
  gateA: number;
  gateB: number;
  centerA: string;
  centerB: string;
  name: string;
  description: string;
}

function lookupChannel(gateA: number, gateB: number): ChannelInfo | null {
  for (const [a, b, ca, cb, name] of CHANNELS) {
    if ((a === gateA && b === gateB) || (a === gateB && b === gateA)) {
      const key = channelKey(gateA, gateB);
      return {
        gateA: a, gateB: b,
        centerA: ca, centerB: cb,
        name,
        description: CHANNEL_DESCRIPTIONS[key] ?? "",
      };
    }
  }
  return null;
}

let chart: Chart | null = null;
let error: string | null = null;
let formData = { date: "", time: "", city: "" };

if (Astro.request.method === "POST") {
  const body = await Astro.request.formData();
  formData = {
    date: String(body.get("date") ?? ""),
    time: String(body.get("time") ?? ""),
    city: String(body.get("city") ?? ""),
  };
  try {
    chart = await generateChart(formData);
  } catch (e) {
    error = e instanceof Error ? e.message : "Unknown error";
  }
}

const channelInfos: ChannelInfo[] = chart
  ? chart.definedChannels
      .map(([a, b]) => lookupChannel(a, b))
      .filter((c): c is ChannelInfo => c !== null)
  : [];
---

<Base title="Free Chart — Mythograph Journey">
  <div class="mx-auto max-w-2xl">
    <h1 class="text-4xl font-light">Your Human Design</h1>
    <p class="mt-3 text-base opacity-70">
      Enter your birth data. We'll begin with your defined channels — the
      themes your life keeps returning to.
    </p>

    <form method="POST" class="mt-8 grid gap-5">
      <div class="grid gap-1.5">
        <label for="date" class="text-sm font-medium">Birth date</label>
        <input
          id="date" name="date" type="date" required
          value={formData.date}
          class="rounded border border-black/20 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#3a4f99]"
        />
      </div>

      <div class="grid gap-1.5">
        <label for="time" class="text-sm font-medium">Birth time (local, 24h)</label>
        <input
          id="time" name="time" type="time" required
          value={formData.time}
          class="rounded border border-black/20 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#3a4f99]"
        />
      </div>

      <div class="grid gap-1.5">
        <label for="city" class="text-sm font-medium">Birth city</label>
        <input
          id="city" name="city" type="text" required placeholder="e.g. London, UK"
          value={formData.city}
          class="rounded border border-black/20 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#3a4f99]"
        />
      </div>

      <button
        type="submit"
        class="mt-2 rounded bg-[#3a4f99] px-6 py-2.5 text-sm font-medium text-white hover:bg-[#2d3f80] transition"
        style="color: white"
      >
        Generate chart
      </button>
    </form>

    {error && (
      <div class="mt-6 rounded border border-red-300 bg-red-50 p-4 text-sm text-red-700">
        {error}
      </div>
    )}

    {chart && (
      <section class="mt-12 space-y-12">

        <!-- Identity hero: tiny bodygraph fingerprint + type / profile / strategy / authority -->
        <header class="flex flex-col sm:flex-row gap-6 items-start sm:items-center">
          <div class="shrink-0 w-32 sm:w-36 opacity-90" set:html={chart.bodygraphSvg} />
          <div class="grow">
            <p class="text-xs uppercase tracking-widest opacity-50 mb-1.5">Profile {chart.profile}</p>
            <h2 class="text-2xl sm:text-3xl font-light leading-tight">
              {chart.authority === "None" ? chart.type : `${chart.authority} ${chart.type}`}
            </h2>
            <p class="mt-2 text-sm opacity-70">
              <span class="font-medium">Strategy:</span> {chart.strategy}
            </p>
          </div>
        </header>

        <!-- Defined channels: the heart of the page -->
        {channelInfos.length > 0 ? (
          <section>
            <h3 class="text-xs uppercase tracking-widest opacity-50 mb-4">Your defined channels</h3>
            <div class="space-y-6">
              {channelInfos.map((c) => (
                <article class="border-l-2 border-[#c05a3c]/40 pl-5 py-1">
                  <div class="flex items-baseline justify-between gap-3 mb-1.5">
                    <h4 class="text-lg font-medium">
                      <span>{c.name}</span>
                      <span class="opacity-40 font-mono text-sm ml-2">{c.gateA}–{c.gateB}</span>
                    </h4>
                    <span class="text-[10px] uppercase tracking-wider opacity-40 whitespace-nowrap">
                      {CENTER_LABELS[c.centerA]} → {CENTER_LABELS[c.centerB]}
                    </span>
                  </div>
                  {c.description ? (
                    <p class="text-[15px] leading-relaxed opacity-80">{c.description}</p>
                  ) : (
                    <p class="text-[13px] italic opacity-40">— no preview copy yet —</p>
                  )}
                </article>
              ))}
            </div>
          </section>
        ) : (
          <section class="rounded-xl border border-black/10 p-5 bg-white/40">
            <h3 class="text-xs uppercase tracking-widest opacity-50 mb-2">Defined channels</h3>
            <p class="text-sm opacity-70">
              You have no fully-defined channels. This is rare and meaningful — your
              design is highly responsive to your environment. The Journey Narrative
              goes deeper into what that means for you.
            </p>
          </section>
        )}

        <!-- Type + Authority -->
        <section class="grid gap-6 sm:grid-cols-2">
          <div>
            <h3 class="text-xs uppercase tracking-widest opacity-50 mb-2">Type</h3>
            <p class="text-base font-medium mb-1.5">{chart.type}</p>
            <p class="text-[14px] leading-relaxed opacity-75">
              {TYPE_DESCRIPTIONS[chart.type]}
            </p>
          </div>
          <div>
            <h3 class="text-xs uppercase tracking-widest opacity-50 mb-2">Authority</h3>
            <p class="text-base font-medium mb-1.5">{chart.authority}</p>
            <p class="text-[14px] leading-relaxed opacity-75">
              {AUTHORITY_DESCRIPTIONS[chart.authority]}
            </p>
          </div>
        </section>

        <!-- Profile + Incarnation Cross -->
        <section class="grid gap-6 sm:grid-cols-2">
          <div>
            <h3 class="text-xs uppercase tracking-widest opacity-50 mb-2">Profile {chart.profile}</h3>
            <p class="text-[14px] leading-relaxed opacity-75">
              {PROFILE_DESCRIPTIONS[chart.profile] ??
                "Your profile shapes how you meet the world. The Journey Narrative goes into the lines and roles in depth."}
            </p>
          </div>
          <div>
            <h3 class="text-xs uppercase tracking-widest opacity-50 mb-2">Incarnation Cross</h3>
            <p class="text-base font-medium leading-snug">{chart.incarnationCross}</p>
            <p class="text-[13px] leading-relaxed opacity-60 mt-1.5">
              The thematic arc of your life — the role you're here to play. Explored in full
              in the Journey Narrative.
            </p>
          </div>
        </section>

        <!-- Activations table (collapsed) -->
        <details class="border-t border-black/10 pt-5">
          <summary class="cursor-pointer text-xs uppercase tracking-widest opacity-50 hover:opacity-80">
            Planetary activations
          </summary>
          <div class="mt-4 grid sm:grid-cols-2 gap-6 text-[12px] leading-snug">
            <div>
              <p class="text-[9px] font-bold uppercase tracking-widest text-[#c0392b] mb-3">Unconscious (Design)</p>
              {chart.designActivations.map((a) => (
                <div class="flex items-baseline justify-between gap-2 py-[3px]">
                  <span class="text-[#c0392b]/80">{PLANET_LABELS[a.planet] ?? a.planet}</span>
                  <span class="font-mono font-semibold text-[#c0392b] tabular-nums">{a.gate}.{a.line}</span>
                </div>
              ))}
            </div>
            <div>
              <p class="text-[9px] font-bold uppercase tracking-widest text-[#111111]/60 mb-3">Conscious (Personality)</p>
              {chart.personalityActivations.map((a) => (
                <div class="flex items-baseline justify-between gap-2 py-[3px]">
                  <span class="text-[#111111]/60">{PLANET_LABELS[a.planet] ?? a.planet}</span>
                  <span class="font-mono font-semibold text-[#111111] tabular-nums">{a.gate}.{a.line}</span>
                </div>
              ))}
            </div>
          </div>
        </details>

        <!-- Debug panel -->
        <details class="text-xs font-mono opacity-50 hover:opacity-80">
          <summary class="cursor-pointer">Debug info</summary>
          <dl class="mt-3 grid gap-1.5">
            <div><dt class="opacity-50">Location found</dt><dd>{chart.debug.geocodedLocation}</dd></div>
            <div><dt class="opacity-50">Timezone</dt><dd>{chart.debug.timezone}</dd></div>
            <div><dt class="opacity-50">Birth UTC</dt><dd>{chart.debug.birthUtc}</dd></div>
            <div><dt class="opacity-50">Design date UTC</dt><dd>{chart.debug.designDate}</dd></div>
            <div><dt class="opacity-50">All activated gates</dt><dd>{chart.debug.allActivatedGates.join(", ")}</dd></div>
          </dl>
        </details>

        <!-- Upsell -->
        <div class="rounded-xl border border-[#3a4f99]/30 bg-[#3a4f99]/5 p-6 mt-4">
          <h2 class="text-lg font-light mb-2">Go deeper with the Journey Narrative</h2>
          <p class="text-sm opacity-70 mb-4">
            A long-form personalised reading written in Cléa Hernández's voice — your channels,
            your gates, your incarnation cross, told as one story.
          </p>
          <a
            href="/#journey-narrative"
            class="inline-block rounded bg-[#3a4f99] px-5 py-2 text-sm font-medium hover:bg-[#2d3f80] transition"
            style="color: white"
          >
            Get your Journey Narrative — $37
          </a>
        </div>
      </section>
    )}

    <p class="mt-10 text-sm">
      <a href="/" class="opacity-50 hover:opacity-100 transition">← back</a>
    </p>
  </div>
</Base>
