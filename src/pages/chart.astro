---
import Base from "~/layouts/Base.astro";
import { generateChart } from "~/lib/chart-engine/index.js";
import type { Chart } from "~/lib/chart-engine/index.js";
import { CHANNELS } from "~/lib/chart-engine/data.js";
import {
  CHANNEL_DESCRIPTIONS,
  TYPE_DESCRIPTIONS,
  AUTHORITY_DESCRIPTIONS,
  PROFILE_DESCRIPTIONS,
  PROFILE_NAMES,
  TYPE_INTRO,
  AUTHORITY_INTRO,
  PROFILE_INTRO,
  INCARNATION_CROSS_INTRO,
  channelKey,
  chartSynopsis,
} from "~/lib/chart-engine/copy.js";

const PLANET_LABELS: Record<string, string> = {
  Sun: "☉ Sun", Earth: "⊕ Earth", Moon: "☽ Moon",
  Mercury: "☿ Mercury", Venus: "♀ Venus", Mars: "♂ Mars",
  Jupiter: "♃ Jupiter", Saturn: "♄ Saturn", Uranus: "♅ Uranus",
  Neptune: "♆ Neptune", Pluto: "♇ Pluto",
  NorthNode: "☊ N. Node", SouthNode: "☋ S. Node",
};

const CENTER_LABELS: Record<string, string> = {
  Head: "Head", Ajna: "Ajna", Throat: "Throat", G: "G",
  Ego: "Ego", Sacral: "Sacral", SolarPlexus: "Solar Plexus",
  Spleen: "Spleen", Root: "Root",
};

interface ChannelInfo {
  gateA: number;
  gateB: number;
  centerA: string;
  centerB: string;
  name: string;
  description: string;
}

function lookupChannel(gateA: number, gateB: number): ChannelInfo | null {
  for (const [a, b, ca, cb, name] of CHANNELS) {
    if ((a === gateA && b === gateB) || (a === gateB && b === gateA)) {
      const key = channelKey(gateA, gateB);
      return {
        gateA: a, gateB: b,
        centerA: ca, centerB: cb,
        name,
        description: CHANNEL_DESCRIPTIONS[key] ?? "",
      };
    }
  }
  return null;
}

// Split a string into parts, marking "Journey Narrative" occurrences so they
// can be rendered as links in the template.
function withJourneyLinks(text: string): { text: string; isLink: boolean }[] {
  return text.split(/(Journey Narrative)/g).map((part) => ({
    text: part,
    isLink: part === "Journey Narrative",
  }));
}

let chart: Chart | null = null;
let error: string | null = null;
let formData = { date: "", time: "", city: "" };

if (Astro.request.method === "POST") {
  const body = await Astro.request.formData();
  formData = {
    date: String(body.get("date") ?? ""),
    time: String(body.get("time") ?? ""),
    city: String(body.get("city") ?? ""),
  };
  try {
    chart = await generateChart(formData);
  } catch (e) {
    error = e instanceof Error ? e.message : "Unknown error";
  }
}

const channelInfos: ChannelInfo[] = chart
  ? chart.definedChannels
      .map(([a, b]) => lookupChannel(a, b))
      .filter((c): c is ChannelInfo => c !== null)
  : [];

const synopsis = chart ? chartSynopsis(chart, channelInfos) : "";
const profileName = chart ? (PROFILE_NAMES[chart.profile] ?? chart.profile) : "";
---

<Base title="Free Chart · Mythograph Journey">
  <div class="mx-auto max-w-2xl">
    <h1 class="text-4xl font-light">Your Human Design</h1>

    <form method="POST" class="mt-8 grid gap-5">
      <div class="grid gap-1.5">
        <label for="date" class="text-sm font-medium">Birth date</label>
        <input
          id="date" name="date" type="date" required
          value={formData.date}
          class="rounded border border-black/20 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#3a4f99]"
        />
      </div>

      <div class="grid gap-1.5">
        <label for="time" class="text-sm font-medium">Birth time (local, 12h)</label>
        <input
          id="time" name="time" type="time" required
          value={formData.time}
          class="rounded border border-black/20 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#3a4f99]"
        />
      </div>

      <div class="grid gap-1.5">
        <label for="city" class="text-sm font-medium">Birth city</label>
        <input
          id="city" name="city" type="text" required placeholder="e.g. London, UK"
          value={formData.city}
          class="rounded border border-black/20 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#3a4f99]"
        />
      </div>

      <button
        type="submit"
        class="mt-2 rounded bg-[#3a4f99] px-6 py-2.5 text-sm font-medium text-white hover:bg-[#2d3f80] transition"
        style="color: white"
      >
        Generate chart
      </button>
    </form>

    {error && (
      <div class="mt-6 rounded border border-red-300 bg-red-50 p-4 text-sm text-red-700">
        {error}
      </div>
    )}

    {chart && (
      <section class="mt-12 space-y-12">

        <!-- Identity hero: tiny bodygraph fingerprint + type / profile / authority -->
        <header class="flex flex-col sm:flex-row gap-6 items-start sm:items-center">
          <div class="shrink-0 w-32 sm:w-36 opacity-90 [&_text]:hidden" set:html={chart.bodygraphSvg} />
          <div class="grow">
            <p class="text-xs uppercase tracking-widest opacity-50 mb-1.5">Profile {chart.profile} · {profileName}</p>
            <h2 class="text-2xl sm:text-3xl font-light leading-tight">
              {chart.authority === "None" ? chart.type : `${chart.authority} ${chart.type}`}
            </h2>
            <p class="mt-2 text-sm opacity-70">
              <span class="font-medium">Strategy:</span> {chart.strategy}
            </p>
          </div>
        </header>

        <!-- Synopsis: through-line of all elements -->
        <section class="border-l-2 border-[#3a4f99]/40 pl-5 py-1">
          <p class="text-[16px] leading-relaxed">
            {withJourneyLinks(synopsis).map((p) =>
              p.isLink
                ? <a href="/#journey-narrative" class="underline decoration-dotted underline-offset-2 hover:decoration-solid">{p.text}</a>
                : <Fragment>{p.text}</Fragment>
            )}
          </p>
        </section>

        <!-- Defined channels -->
        {channelInfos.length > 0 ? (
          <section>
            <h3 class="text-xs uppercase tracking-widest opacity-50 mb-4">Your defined channels</h3>
            <div class="space-y-6">
              {channelInfos.map((c) => (
                <article class="border-l-2 border-[#c05a3c]/40 pl-5 py-1">
                  <div class="flex items-baseline justify-between gap-3 mb-1.5">
                    <h4 class="text-lg font-medium">
                      <span>{c.name}</span>
                      <span class="opacity-40 font-mono text-sm ml-2">{c.gateA}–{c.gateB}</span>
                    </h4>
                    <span class="text-[10px] uppercase tracking-wider opacity-40 whitespace-nowrap">
                      {CENTER_LABELS[c.centerA]} ↔ {CENTER_LABELS[c.centerB]}
                    </span>
                  </div>
                  {c.description ? (
                    <p class="text-[15px] leading-relaxed opacity-80">
                      {withJourneyLinks(c.description).map((p) =>
                        p.isLink
                          ? <a href="/#journey-narrative" class="underline decoration-dotted underline-offset-2 hover:decoration-solid">{p.text}</a>
                          : <Fragment>{p.text}</Fragment>
                      )}
                    </p>
                  ) : (
                    <p class="text-[13px] italic opacity-40">No preview copy yet.</p>
                  )}
                </article>
              ))}
            </div>
          </section>
        ) : (
          <section class="rounded-xl border border-black/10 p-5 bg-white/40">
            <h3 class="text-xs uppercase tracking-widest opacity-50 mb-2">Defined channels</h3>
            <p class="text-sm opacity-70">
              You have no fully-defined channels. This is unusual and meaningful. Your
              design is highly responsive to who and what is in the room with you. The{" "}
              <a href="/#journey-narrative" class="underline decoration-dotted underline-offset-2 hover:decoration-solid">Journey Narrative</a>
              {" "}goes deeper into what that means.
            </p>
          </section>
        )}

        <!-- Type -->
        <section>
          <h3 class="text-xs uppercase tracking-widest opacity-50 mb-2">Type</h3>
          <p class="text-[13px] leading-relaxed opacity-60 mb-3">{TYPE_INTRO}</p>
          <p class="text-base font-medium mb-2">{chart.type}</p>
          <p class="text-[15px] leading-relaxed opacity-85">
            {withJourneyLinks(TYPE_DESCRIPTIONS[chart.type]).map((p) =>
              p.isLink
                ? <a href="/#journey-narrative" class="underline decoration-dotted underline-offset-2 hover:decoration-solid">{p.text}</a>
                : <Fragment>{p.text}</Fragment>
            )}
          </p>
        </section>

        <!-- Authority -->
        <section>
          <h3 class="text-xs uppercase tracking-widest opacity-50 mb-2">Authority</h3>
          <p class="text-[13px] leading-relaxed opacity-60 mb-3">{AUTHORITY_INTRO}</p>
          <p class="text-base font-medium mb-2">{chart.authority}</p>
          <p class="text-[15px] leading-relaxed opacity-85">
            {withJourneyLinks(AUTHORITY_DESCRIPTIONS[chart.authority]).map((p) =>
              p.isLink
                ? <a href="/#journey-narrative" class="underline decoration-dotted underline-offset-2 hover:decoration-solid">{p.text}</a>
                : <Fragment>{p.text}</Fragment>
            )}
          </p>
        </section>

        <!-- Profile -->
        <section>
          <h3 class="text-xs uppercase tracking-widest opacity-50 mb-2">Profile</h3>
          <p class="text-[13px] leading-relaxed opacity-60 mb-3">{PROFILE_INTRO}</p>
          <p class="text-base font-medium mb-2">
            {chart.profile} · {profileName}
          </p>
          <p class="text-[15px] leading-relaxed opacity-85">
            {withJourneyLinks(PROFILE_DESCRIPTIONS[chart.profile] ?? "Your profile shapes how you meet the world. The Journey Narrative goes into the lines and roles in depth.").map((p) =>
              p.isLink
                ? <a href="/#journey-narrative" class="underline decoration-dotted underline-offset-2 hover:decoration-solid">{p.text}</a>
                : <Fragment>{p.text}</Fragment>
            )}
          </p>
        </section>

        <!-- Incarnation Cross -->
        <section>
          <h3 class="text-xs uppercase tracking-widest opacity-50 mb-2">Incarnation Cross</h3>
          <p class="text-[13px] leading-relaxed opacity-60 mb-3">{INCARNATION_CROSS_INTRO}</p>
          <p class="text-base font-medium leading-snug mb-2">{chart.incarnationCross}</p>
          <p class="text-[15px] leading-relaxed opacity-85">
            The thematic arc of your life, named.{" "}
            <a href="/#journey-narrative" class="underline decoration-dotted underline-offset-2 hover:decoration-solid">The Journey Narrative</a>
            {" "}reads yours in full.
          </p>
        </section>

        <!-- Planetary activations -->
        <section>
          <h3 class="text-base font-medium mb-2">Planetary activations</h3>
          <p class="text-[13px] leading-relaxed opacity-60 mb-4">
            The 26 planetary positions that built your design. The unconscious column is your
            Design (red): the imprint of who you are at the body level, set 88 days before birth.
            The conscious column is your Personality (black): the imprint of who you experience
            yourself to be, set at the moment of your birth.
          </p>
          <div class="grid sm:grid-cols-2 gap-8 text-[14px] leading-snug">
            <div>
              <p class="text-[11px] font-bold uppercase tracking-widest text-[#c0392b] mb-3">
                Unconscious (Design)
              </p>
              {chart.designActivations.map((a) => (
                <div class="flex items-baseline justify-between gap-3 py-1 border-b border-[#c0392b]/10 last:border-0">
                  <span class="text-[#c0392b]/85">{PLANET_LABELS[a.planet] ?? a.planet}</span>
                  <span class="font-mono font-semibold text-[#c0392b] tabular-nums">{a.gate}.{a.line}</span>
                </div>
              ))}
            </div>
            <div>
              <p class="text-[11px] font-bold uppercase tracking-widest text-[#111111]/65 mb-3">
                Conscious (Personality)
              </p>
              {chart.personalityActivations.map((a) => (
                <div class="flex items-baseline justify-between gap-3 py-1 border-b border-black/10 last:border-0">
                  <span class="text-[#111111]/65">{PLANET_LABELS[a.planet] ?? a.planet}</span>
                  <span class="font-mono font-semibold text-[#111111] tabular-nums">{a.gate}.{a.line}</span>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- Imprint info -->
        <details class="text-xs font-mono opacity-50 hover:opacity-80">
          <summary class="cursor-pointer">Imprint info</summary>
          <dl class="mt-3 grid gap-1.5">
            <div><dt class="opacity-50">Location found</dt><dd>{chart.debug.geocodedLocation}</dd></div>
            <div><dt class="opacity-50">Timezone</dt><dd>{chart.debug.timezone}</dd></div>
            <div><dt class="opacity-50">Birth UTC</dt><dd>{chart.debug.birthUtc}</dd></div>
            <div><dt class="opacity-50">Design date UTC</dt><dd>{chart.debug.designDate}</dd></div>
            <div><dt class="opacity-50">All activated gates</dt><dd>{chart.debug.allActivatedGates.join(", ")}</dd></div>
          </dl>
        </details>

        <!-- Upsell -->
        <div id="journey-narrative-upsell" class="rounded-xl border border-[#3a4f99]/30 bg-[#3a4f99]/5 p-6 mt-4">
          <h2 class="text-lg font-light mb-2">Go deeper with the Journey Narrative</h2>
          <p class="text-sm opacity-70 mb-4">
            A long-form personalised reading written in Cléa Hernández's voice.
            Your channels, your gates, your incarnation cross, told as one story.
          </p>
          <a
            href="/#journey-narrative"
            class="inline-block rounded bg-[#3a4f99] px-5 py-2 text-sm font-medium hover:bg-[#2d3f80] transition"
            style="color: white"
          >
            Get your Journey Narrative ($37)
          </a>
        </div>
      </section>
    )}

    <p class="mt-10 text-sm">
      <a href="/" class="opacity-50 hover:opacity-100 transition">← back</a>
    </p>
  </div>
</Base>
