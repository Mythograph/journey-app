---
import Base from "~/layouts/Base.astro";
---

<Base title="Mythograph Journey">
  <h1>Mythograph Journey</h1>
  <p class="mt-6 text-lg">
    A Human Design bodygraph chart and a long-form Journey Narrative reading,
    in Cléa Hernández's voice.
  </p>

  <section class="mt-12 grid gap-6 sm:grid-cols-2">
    <a
      href="/chart"
      class="block rounded-lg border border-[color:var(--color-ink)]/10 p-6 transition hover:border-[color:var(--color-indigo)]"
    >
      <h2 class="text-2xl">Free chart</h2>
      <p class="mt-2 text-base">Generate your bodygraph from your birth data.</p>
    </a>
    <a
      id="journey-narrative"
      href="https://buy.stripe.com/28E8wQ0uX1t1auT61sfAc08"
      class="block rounded-lg border border-[color:var(--color-ink)]/10 p-6 transition hover:border-[color:var(--color-indigo)]"
    >
      <h2 class="text-2xl">Journey Narrative — $37</h2>
      <p class="mt-2 text-base">A long-form personal reading in Cléa Hernández's voice.</p>
    </a>
  </section>
</Base>
