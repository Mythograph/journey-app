# Mythograph Journey — environment variables
# Copy to .env.local for local dev. Configure these in Netlify dashboard for prod.

# Anthropic (narrative engine — Day 4)
ANTHROPIC_API_KEY=

# Stripe (Day 1 setup, Day 3 webhook wiring)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Make.com webhooks
# Inbound (Stripe → Make → token gen → email): configured in Make, not here
# Outbound (App → Make → narrative email + Kit tag): app POSTs to this URL
MAKE_NARRATIVE_WEBHOOK_URL=

# Kit (free plan, tagging only — used inside Make scenarios, not here)
# KIT_API_KEY lives in Make, not the app.

# Netlify Blobs auto-injects credentials in deployed env.
# Local dev only: uncomment + fill if testing Blobs locally.
# NETLIFY_SITE_ID=
# NETLIFY_BLOBS_TOKEN=
